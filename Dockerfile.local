# Dockerfile.local — Build Caddy with local plugin and local libdns repo
#
# Build context should be the parent folder that contains both:
#   - caddy-dns/joker
#   - libdns/joker
#
# Example:
#   docker build -f caddy-dns/joker/Dockerfile.local /home/sam/Projects/caddy

FROM caddy:builder AS builder

WORKDIR /build

# Copy only go.mod/go.sum first for caching
COPY caddy-dns/joker/go.mod caddy-dns/joker/go.sum ./

# Copy the local libdns provider and replace module path
COPY libdns/joker /libdns-joker
RUN go mod edit -replace github.com/samliddicott/libdns-joker=/libdns-joker

# Download dependencies first (cached unless go.mod/go.sum changes)
RUN go mod download

# Copy the plugin source
COPY caddy-dns/joker ./

# Build Caddy with the local plugin
RUN set -eux; \
    xcaddy build v2.10.2 \
      --with github.com/samliddicott/caddy-dns-joker=/build \
      --output /usr/bin/caddy

FROM caddy:2.10.2

# Copy custom Caddy binary
COPY --from=builder /usr/bin/caddy /usr/bin/caddy

# Expose standard HTTP/S ports
EXPOSE 80 443

# Environment variables for Joker DNS credentials
ENV JOKER_USERNAME=""
ENV JOKER_PASSWORD=""

# Copy default Caddyfile
COPY caddy-dns/joker/Caddyfile /etc/caddy/Caddyfile

# Run Caddy
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
